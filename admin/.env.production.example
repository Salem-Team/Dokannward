# Production Laravel admin — copy to `admin/.env` on the server only.
# Deploy aborts if any of these still point at localhost.
APP_NAME="Dokan Ward"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dokannward.com

FRONTEND_URL=https://dokannward.com
STOREFRONT_URL=https://dokannward.com
STOREFRONT_PUBLIC_URL=https://dokannward.com
CORS_ALLOWED_ORIGINS=https://dokannward.com
REVALIDATE_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Set a strong unique password before first seed; rotate after bootstrap.
ADMIN_SEED_EMAIL=admin@dokannward.com
ADMIN_SEED_NAME="Dokan Ward Admin"
ADMIN_SEED_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Prefer Redis in production (falls back to file if Redis is unavailable).
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dokannward.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
